# 1. Force GitHub to treat the CloudFormation language as detectable in the stats bar
* linguist-language=CloudFormation
* linguist-detectable=true

# 2. Reclassify files inside the infrastructure folder
infra/**/*.yaml linguist-language=CloudFormation
infra/**/*.yml linguist-language=CloudFormation

# 3. Explicitly hide CI/CD workflows and other YAML folders
.github/workflows/** linguist-detectable=false