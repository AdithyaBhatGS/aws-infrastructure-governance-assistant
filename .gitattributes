# 1. Un-exclude YAML globally so GitHub tracks it as a detectable language
*.yaml linguist-detectable=true
*.yml linguist-detectable=true

# 2. Reclassify files inside the 'infrastructure' folder as CloudFormation
infra/**/*.yaml linguist-language=CloudFormation
infra/**/*.yml linguist-language=CloudFormation

# 3. Explicitly hide CI/CD workflows and other YAML folders you don't want counted
.github/workflows/** linguist-detectable=false
